{
  "info": {
    "name": "BRIVET - API Integration",
    "description": "Colección de pruebas para los endpoints públicos de BRIVET: login, búsqueda y registro de mascotas perdidas/encontradas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://brivetvzla.com/api",
      "type": "string",
      "description": "URL base de producción. Para desarrollo local cambiar a http://localhost:8080"
    },
    {
      "key": "estadoId_valido",
      "value": "10",
      "type": "string",
      "description": "Distrito Capital (Caracas). Ver sección 5 del API Guide para lista completa."
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT token — se llena automáticamente al ejecutar el request de login exitoso."
    }
  ],
  "item": [
    {
      "name": "0. Login (auth)",
      "item": [
        {
          "name": "POST /auth/login - Credenciales correctas (happy path)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.token) {",
                  "        pm.collectionVariables.set('token', json.token);",
                  "        console.log('Token guardado en variable de colección: token');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"vet@vpv.com\",\n  \"password\": \"demo1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Login del veterinario. Responde 200 con el objeto usuario y el JWT token. El script de test guarda el token automáticamente en la variable {{token}} de la colección para usarlo en requests protegidos."
          },
          "response": []
        },
        {
          "name": "POST /auth/login - Error: password incorrecto",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"vet@vpv.com\",\n  \"password\": \"password_incorrecto\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Debe responder 401 Unauthorized con mensaje 'usuario/contraseña incorrectos'. El FE debe mostrar un error de credenciales al usuario, sin especificar si el email o el password es el incorrecto (buena práctica de seguridad)."
          },
          "response": []
        },
        {
          "name": "POST /auth/login - Error: email no existe",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"noexiste@vpv.com\",\n  \"password\": \"demo1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Debe responder 401 Unauthorized. Mismo mensaje que password incorrecto — el backend no distingue entre email inexistente y password malo para evitar enumeration attacks."
          },
          "response": []
        },
        {
          "name": "POST /auth/login - Error: falta campo email",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"demo1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Debe responder 400 Bad Request. El campo email es @NotBlank en LoginRequest — Spring valida antes de llegar al Service y devuelve el detalle del campo inválido."
          },
          "response": []
        },
        {
          "name": "POST /auth/login - Error: email con formato inválido",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"esto-no-es-un-email\",\n  \"password\": \"demo1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Debe responder 400 Bad Request. El campo email tiene @Email en LoginRequest — Spring valida el formato antes de llegar al Service."
          },
          "response": []
        },
        {
          "name": "POST /auth/login - Error: campo incorrecto (username en vez de email)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"vet@vpv.com\",\n  \"password\": \"demo1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Error común de integración: enviar 'username' en vez de 'email'. Debe responder 400 Bad Request indicando que el campo email es obligatorio y está null. El campo correcto es siempre 'email'."
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. createSolicitud",
      "item": [
        {
          "name": "POST /solicitud - Mascota PERDIDA con foto (happy path)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "data",
                  "value": "{\n  \"tipoSolicitud\": \"PERDIDA\",\n  \"animal\": {\n    \"nombre\": \"Firulais\",\n    \"especie\": \"PERRO\",\n    \"raza\": \"Mestizo\",\n    \"color\": \"Marrón\",\n    \"tamanio\": \"MEDIANO\",\n    \"sexo\": \"MACHO\",\n    \"edadAproximada\": 3,\n    \"descripcion\": \"Tiene una mancha blanca en el pecho\",\n    \"requiereAtencionMedica\": false\n  },\n  \"ubicacion\": {\n    \"estadoId\": {{estadoId_valido}},\n    \"ciudad\": \"Caracas\",\n    \"direccion\": \"Av. Principal, Sector X\",\n    \"referencia\": \"Cerca de la plaza\"\n  },\n  \"contacto\": {\n    \"nombre\": \"Ana\",\n    \"apellido\": \"Martins\",\n    \"email\": \"ana@test.com\",\n    \"telefono\": \"+584121234567\",\n    \"whatsapp\": \"+584121234567\",\n    \"metodoContacto\": \"WHATSAPP\",\n    \"permitirDatosPublicos\": true\n  }\n}",
                  "type": "text",
                  "contentType": "application/json"
                },
                {
                  "key": "fotos",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/solicitud",
              "host": ["{{base_url}}"],
              "path": ["solicitud"]
            },
            "description": "Caso exitoso: reporta una mascota perdida con foto adjunta. Debe responder 200 con el objeto Solicitud completo incluyendo mainPhotoUrl con la URL de S3. El campo 'fotos' es un file picker — seleccionar manualmente un archivo de imagen antes de enviar. NO requiere token."
          },
          "response": []
        },
        {
          "name": "POST /solicitud - Mascota ENCONTRADA sin foto (happy path)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "data",
                  "value": "{\n  \"tipoSolicitud\": \"ENCONTRADA\",\n  \"animal\": {\n    \"nombre\": null,\n    \"especie\": \"GATO\",\n    \"raza\": \"Comun europeo\",\n    \"color\": \"Gris atigrado\",\n    \"tamanio\": \"PEQUENO\",\n    \"sexo\": null,\n    \"edadAproximada\": 1,\n    \"descripcion\": \"Gatito encontrado cerca del estacionamiento, sin collar\",\n    \"requiereAtencionMedica\": true\n  },\n  \"ubicacion\": {\n    \"estadoId\": {{estadoId_valido}},\n    \"ciudad\": \"Caracas\",\n    \"direccion\": \"Centro Comercial Sambil, estacionamiento nivel 2\",\n    \"referencia\": \"Cerca de la entrada principal\"\n  },\n  \"contacto\": {\n    \"nombre\": \"Jose\",\n    \"apellido\": \"Rodriguez\",\n    \"email\": \"jose@test.com\",\n    \"telefono\": \"+584129876543\",\n    \"whatsapp\": \"+584129876543\",\n    \"metodoContacto\": \"WHATSAPP\",\n    \"permitirDatosPublicos\": true\n  }\n}",
                  "type": "text",
                  "contentType": "application/json"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/solicitud",
              "host": ["{{base_url}}"],
              "path": ["solicitud"]
            },
            "description": "Caso exitoso sin foto. mainPhotoUrl debe venir vacío en el response. nombre y sexo son null intencionalmente — en mascotas encontradas suelen ser desconocidos. NO requiere token."
          },
          "response": []
        },
        {
          "name": "POST /solicitud - Error: falta campo obligatorio (contacto.email)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "data",
                  "value": "{\n  \"tipoSolicitud\": \"PERDIDA\",\n  \"animal\": {\n    \"nombre\": \"Luna\",\n    \"especie\": \"PERRO\",\n    \"tamanio\": \"MEDIANO\"\n  },\n  \"ubicacion\": {\n    \"estadoId\": {{estadoId_valido}},\n    \"ciudad\": \"Maracay\",\n    \"direccion\": \"Calle Principal\"\n  },\n  \"contacto\": {\n    \"nombre\": \"Maria\",\n    \"apellido\": \"Gonzalez\",\n    \"telefono\": \"+584121111111\",\n    \"whatsapp\": \"+584121111111\",\n    \"metodoContacto\": \"WHATSAPP\"\n  }\n}",
                  "type": "text",
                  "contentType": "application/json"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/solicitud",
              "host": ["{{base_url}}"],
              "path": ["solicitud"]
            },
            "description": "Error de validación: falta contacto.email (@NotBlank). Debe responder 400 Bad Request con el nombre del campo inválido en el mensaje."
          },
          "response": []
        },
        {
          "name": "POST /solicitud - Error: estadoId inexistente",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "data",
                  "value": "{\n  \"tipoSolicitud\": \"PERDIDA\",\n  \"animal\": {\n    \"nombre\": \"Rocky\",\n    \"especie\": \"PERRO\",\n    \"tamanio\": \"GRANDE\"\n  },\n  \"ubicacion\": {\n    \"estadoId\": 9999,\n    \"ciudad\": \"Ciudad Inventada\",\n    \"direccion\": \"Calle Falsa 123\"\n  },\n  \"contacto\": {\n    \"nombre\": \"Pedro\",\n    \"apellido\": \"Perez\",\n    \"email\": \"pedro@test.com\",\n    \"telefono\": \"+584125555555\",\n    \"whatsapp\": \"+584125555555\",\n    \"metodoContacto\": \"WHATSAPP\"\n  }\n}",
                  "type": "text",
                  "contentType": "application/json"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/solicitud",
              "host": ["{{base_url}}"],
              "path": ["solicitud"]
            },
            "description": "Error de negocio: estadoId 9999 no existe en la tabla estado. Debe responder 500 con mensaje 'Estado no encontrado: 9999'."
          },
          "response": []
        },
        {
          "name": "POST /solicitud - Error: tipoSolicitud invalido (enum)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "data",
                  "value": "{\n  \"tipoSolicitud\": \"DESAPARECIDA\",\n  \"animal\": {\n    \"nombre\": \"Toby\",\n    \"especie\": \"PERRO\"\n  },\n  \"ubicacion\": {\n    \"estadoId\": {{estadoId_valido}},\n    \"ciudad\": \"Valencia\",\n    \"direccion\": \"Av. Bolivar\"\n  },\n  \"contacto\": {\n    \"nombre\": \"Luis\",\n    \"apellido\": \"Diaz\",\n    \"email\": \"luis@test.com\",\n    \"telefono\": \"+584123333333\",\n    \"whatsapp\": \"+584123333333\",\n    \"metodoContacto\": \"WHATSAPP\"\n  }\n}",
                  "type": "text",
                  "contentType": "application/json"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/solicitud",
              "host": ["{{base_url}}"],
              "path": ["solicitud"]
            },
            "description": "Error de deserialización: DESAPARECIDA no es un valor válido del enum TipoSolicitud (solo PERDIDA o ENCONTRADA). Debe responder 400 Bad Request."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. searchSolicitudes",
      "item": [
        {
          "name": "GET /solicitud/search - Solo tipo (todas las perdidas)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/solicitud/search?tipo=PERDIDA",
              "host": ["{{base_url}}"],
              "path": ["solicitud", "search"],
              "query": [
                { "key": "tipo", "value": "PERDIDA" }
              ]
            },
            "description": "Lista todas las mascotas perdidas sin filtros. Responde 200 con array de Solicitud. Puede ser [] si no hay datos. NO requiere token."
          },
          "response": []
        },
        {
          "name": "GET /solicitud/search - Tipo + especie (perros perdidos)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/solicitud/search?tipo=PERDIDA&especie=PERRO",
              "host": ["{{base_url}}"],
              "path": ["solicitud", "search"],
              "query": [
                { "key": "tipo", "value": "PERDIDA" },
                { "key": "especie", "value": "PERRO" }
              ]
            },
            "description": "Filtro combinado tipo + especie. Solo solicitudes donde animal.especie = 'P' (Perro)."
          },
          "response": []
        },
        {
          "name": "GET /solicitud/search - Tipo + ciudad (encontradas en Caracas)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/solicitud/search?tipo=ENCONTRADA&ciudad=Caracas",
              "host": ["{{base_url}}"],
              "path": ["solicitud", "search"],
              "query": [
                { "key": "tipo", "value": "ENCONTRADA" },
                { "key": "ciudad", "value": "Caracas" }
              ]
            },
            "description": "Búsqueda parcial case-insensitive sobre ciudad. 'caracas', 'CARACAS' o 'Caracas' devuelven el mismo resultado."
          },
          "response": []
        },
        {
          "name": "GET /solicitud/search - Tipo + estadoId",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/solicitud/search?tipo=PERDIDA&estadoId={{estadoId_valido}}",
              "host": ["{{base_url}}"],
              "path": ["solicitud", "search"],
              "query": [
                { "key": "tipo", "value": "PERDIDA" },
                { "key": "estadoId", "value": "{{estadoId_valido}}" }
              ]
            },
            "description": "Filtro por estado venezolano (FK ubicacion.estado.id = 10 = Distrito Capital)."
          },
          "response": []
        },
        {
          "name": "GET /solicitud/search - Todos los filtros combinados",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/solicitud/search?tipo=PERDIDA&especie=GATO&estadoId={{estadoId_valido}}&ciudad=Caracas",
              "host": ["{{base_url}}"],
              "path": ["solicitud", "search"],
              "query": [
                { "key": "tipo", "value": "PERDIDA" },
                { "key": "especie", "value": "GATO" },
                { "key": "estadoId", "value": "{{estadoId_valido}}" },
                { "key": "ciudad", "value": "Caracas" }
              ]
            },
            "description": "Los 4 filtros a la vez: tipo + especie + estadoId + ciudad."
          },
          "response": []
        },
        {
          "name": "GET /solicitud/search - Error: falta parametro obligatorio 'tipo'",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/solicitud/search?ciudad=Caracas",
              "host": ["{{base_url}}"],
              "path": ["solicitud", "search"],
              "query": [
                { "key": "ciudad", "value": "Caracas" }
              ]
            },
            "description": "Debe responder 400 Bad Request. 'tipo' es @RequestParam obligatorio sin required=false."
          },
          "response": []
        },
        {
          "name": "GET /solicitud/search - Error: tipo con valor invalido",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/solicitud/search?tipo=ROBADA",
              "host": ["{{base_url}}"],
              "path": ["solicitud", "search"],
              "query": [
                { "key": "tipo", "value": "ROBADA" }
              ]
            },
            "description": "Debe responder 400 Bad Request. ROBADA no es un valor del enum TipoSolicitud."
          },
          "response": []
        },
        {
          "name": "GET /solicitud/search - Sin resultados (estado inexistente)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/solicitud/search?tipo=PERDIDA&estadoId=9999",
              "host": ["{{base_url}}"],
              "path": ["solicitud", "search"],
              "query": [
                { "key": "tipo", "value": "PERDIDA" },
                { "key": "estadoId", "value": "9999" }
              ]
            },
            "description": "No es un error técnico: estadoId 9999 no existe pero search no valida su existencia, simplemente no habrá coincidencias. Debe responder 200 con array vacío []."
          },
          "response": []
        }
      ]
    }
  ]
}
